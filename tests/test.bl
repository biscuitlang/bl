/*

Unified term: 'multi-value expression'.

CHECK:
Foo.{ x += 1 }
#if #if
x, y;
XX, YY: s32 = foo(); // type must be inferred


Single value:

a, b    := 10;
a, b, c := foo(); // foo returns single value

foo() catch {}
x :: foo();
x :: foo() catch {}

 */

#import "std/print"
#import "std/test"

foo :: fn (_: ?T) u64 {
	a: s32;
	return cast(u64) &a;
}

main :: fn () s32 {
	first :: foo(10);
	test_eq(foo(20), first);

	n1 : s32 = 10;
	test_eq(foo(n1), first);

	n2 : s64 = 10;
	test_eq(foo(cast(s32)n2), first);

	return 0;
}
