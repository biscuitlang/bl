/*

Unified term: 'multi-value expression'.

CHECK:
Foo.{ x += 1 }
#if #if
x, y;
XX, YY: s32 = foo(); // type must be inferred


Single value:

a, b    := 10;
a, b, c := foo(); // foo returns single value

foo() catch {}
x :: foo();
x :: foo() catch {}

 */

#import "std/print"
#import "std/thread2"

main :: fn () s32 {
	worker :: fn () s32 {
		print("Worker thread: %\n", get_current_thread_wid());
		return 0;
	};

	print("Main thread: %\n", get_current_thread_wid());

	threads: [10]*Thread;
	loop i := 0; i < threads.len; i += 1 {
		threads[i] = spawn(&worker);
	}

	join_all(threads);
	destroy_all(threads);

	return 0;
}
