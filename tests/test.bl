/*

Unified term: 'multi-value expression'.

CHECK:
Foo.{ x += 1 }
#if #if
x, y;
XX, YY: s32 = foo(); // type must be inferred


Single value:

a, b    := 10;
a, b, c := foo(); // foo returns single value

foo() catch {}
x :: foo();
x :: foo() catch {}

 */

#import "std/print"
hash_table :: #import "std/table";

Foo :: fn (T: type #comptime) type #comptime {
	return struct {
		n: T;
	};
}

foo :: fn (_: ?T) {
	if is_produced_by(T, Foo) {
		print("OK\n");
	} else {
		print("Nope\n");
	}
}

