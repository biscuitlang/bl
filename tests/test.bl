/*

Unified term: 'multi-value expression'.

CHECK:
Foo.{ x += 1 }
#if #if
x, y;
XX, YY: s32 = foo(); // type must be inferred


Single value:

a, b    := 10;
a, b, c := foo(); // foo returns single value

foo() catch {}
x :: foo();
x :: foo() catch {}

 */

#import "std/print"
atomic :: #import "std/atomic";

main :: fn () s32 {
	{
		n: atomic.s32_a;
		atomic.store(&n, 10);
		v :: atomic.load(&n);
		print_log("v = %\n", v);
	}

	{
		n: atomic.bool_a;
		atomic.store(&n, true);
		v :: atomic.load(&n);
		print_log("v = %\n", v);
	}

	return 0;
}
