/*

Unified term: 'multi-value expression'.

CHECK:
Foo.{ x += 1 }
#if #if
x, y;
XX, YY: s32 = foo(); // type must be inferred


Single value:

a, b    := 10;
a, b, c := foo(); // foo returns single value

foo() catch {}
x :: foo();
x :: foo() catch {}

 */

#import "std/print"

main :: fn () s32 {
	loop i := 0; i < 10; i += 1 {
		if i < 9 then continue;

		defer foo();

		if i == 9 {
			continue;
		}
	}

	return 0;
}

foo :: fn () {
	print("foo called!");
}

