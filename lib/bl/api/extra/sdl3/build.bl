#load "extra/build-lib-common.bl"

SDL_SRC_DIR :: "SDL3-3.4.14";

main :: fn () s32 {
	tmpdir :: get_temporary();
	unzip(tprint("%.zip", SDL_SRC_DIR));

	rootdir :: get_cwd();
	build_dir :: tprint("%/build", SDL_SRC_DIR);
	create_dir(build_dir);

	using Platform;
	switch PLATFORM {
		WINDOWS {
			set_cwd(build_dir);
			cmake(
				"..",
				"--fresh",
				"-DSDL_SHARED=ON",
				"-DSDL_STATIC=ON",
				"-DSDL_TEST_LIBRARY=OFF",
				"-DSDL_EXAMPLES=OFF",
				"-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
				tprint("-DCMAKE_INSTALL_PREFIX=%", tmpdir),
			);
			cmake("--build", ".", "--config=Release", "--target=Install");
			set_cwd(rootdir);
			create_dir("win32");
			copy_file(tprint("%/bin/SDL3.dll", tmpdir), "win32/SDL3.dll", true) catch return -1;
			copy_file(tprint("%/lib/SDL3.lib", tmpdir), "win32/SDL3.lib", true) catch return -1;
			copy_file(tprint("%/lib/SDL3-static.lib", tmpdir), "win32/SDL3_static.lib", true) catch return -1;
		}
		LINUX {
			set_cwd(build_dir);
			cmake(
				"..",
				"--fresh",
				"-DSDL_SHARED=ON",
				"-DSDL_STATIC=ON",
				"-DSDL_TEST_LIBRARY=OFF",
				"-DSDL_EXAMPLES=OFF",
				"-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
				tprint("-DCMAKE_INSTALL_PREFIX=%", tmpdir),
			);
			make("install");

			set_cwd(rootdir);
			create_dir("linux");
			if os_execute(tprint("cp -d %/lib/libSDL* linux/", tmpdir)) != 0 then return -1;
		}
		DARWIN {
			set_cwd(build_dir);
			cmake(
				"..",
				"--fresh",
				"-DSDL_SHARED=ON",
				"-DSDL_STATIC=ON",
				"-DSDL_TEST_LIBRARY=OFF",
				"-DSDL_EXAMPLES=OFF",
				"-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
				"-DCMAKE_OSX_DEPLOYMENT_TARGET=12.0",
				"-DCMAKE_MACOSX_RPATH=ON",
				tprint("-DCMAKE_INSTALL_PREFIX=%", tmpdir),
			);
			make("install");

			set_cwd(rootdir);
			create_dir("macos");
			if os_execute(tprint("cp -P %/lib/libSDL* macos/", tmpdir)) != 0 then return -1;
		}
		default;
	}

	set_cwd(rootdir);
	os_execute(tprint("rm -rf %", SDL_SRC_DIR));
	return 0;
}
