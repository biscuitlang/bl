//! # Message Queue
//!
//! `#import "std/message_queue"`
//!
//! Thread-safe FIFO message queue with blocking/non-blocking post-poll mechanics.
//!
//! This is particularly useful for passing user-defined messages from one thread to another. Consider you have a worker
//! thread doing some job controlled by the main thread. The worker thread simply waits on the `poll` procedure, when a
//! new message arrives from the main thread, the worker thread wakes and processes the message.
//!
//! Messages can contain any arbitrary data, an allocator from `MessagePool` is used to allocate every message, and the
//! same allocator might be used to allocate any additional data carried with the message, this way, payload data
//! lifetime is scoped into the message and is automatically released on `terminate_message` call when message was
//! consumed by the worker.
//!
//! ### Example
//!
//! ```bl
//! @@@examples/message_queue.bl
//! ```

/// Default maximum count of pending messages in the queue.
DEFAULT_MAX_MESSAGES :: 1000;

/// Default memory size reserved for every message.
DEFAULT_MESSAGE_SIZE : usize : 8192; // 8kB

Queue :: struct {
	pool:      *MessagePool;
	pool_owned: bool;

	head:     *Message;
	mutex:     Mutex;
	condition: Condition;

	num: s32;
	max_messages: s32;
}

/// Message pool stores individual allocators used for every message. When message is released, its allocator
/// is returned to the pool and reused later.
MessagePool :: struct {
	pools:          BucketArray(PoolAllocator);
	available: [..]*Allocator;
	mutex:          Mutex;

	expected_message_bytes: usize;
}

/// Initialize `pool` to store allocators used by messages. In case the pool is empty, a new allocator
/// is created with `expected_message_bytes` page size. Note the size of individual messages is not limited by
/// this number, allocated memory might grow if message is bigger; however you might reduce some overhead by
/// preallocating pool to the common size of messages used. Also note that the message itself use the same
/// allocator as any additional payload attached to it.
///
/// Pool is supposed to be terminated by [terminate_pool](modules_message_queue.html#terminate_pool).
init_pool :: fn (pool: *MessagePool, expected_message_bytes := DEFAULT_MESSAGE_SIZE) {
	assert(expected_message_bytes >= sizeof(Message));
	zeroinit(pool);
	mutex_init(&pool.mutex);
}

/// Terminates the `pool`.
terminate_pool :: fn (pool: *MessagePool) {
	loop it := bucket_array_begin(&pool.pools); it; it = bucket_array_iter_next(&pool.pools, it) {
		release_allocator(&it.value);
	}

	bucket_array_terminate(&pool.pools);
	array_terminate(&pool.available);
	mutex_terminate(&pool.mutex);
	zeroinit(pool);
}

/// Message base structure. Every message passed to the queue must inherit this type.
Message :: struct {
	/// Allocator used for message, can be used to allocate any additional payload.
	allocator:    *Allocator;
	/// Message type id. Use this to distinguish message types before casting.
	typeid:        u64;
	parent_queue: *Queue;
	_next:        *Message;
	is_posted:     bool;
}

/// Initialize `queue`. The `pool` message pool might be provided explicitly (one pool might be shared across
/// multiple queues). When the `pool` is not provided, a new one is created implicitly, sharing the lifetime with
/// the `queue`. The `max_messages` limits the maximum count of unprocessed (pending) messages in the `queue`.
///
/// Queue is supposed to be terminated by [terminate](modules_message_queue.html#terminate).
init :: fn (queue: *Queue, pool: *MessagePool = null, max_messages := DEFAULT_MAX_MESSAGES) {
	assert(max_messages > 0);

	if !pool {
		queue.pool = pool;
	} else {
		queue.pool = new(MessagePool);
		queue.pool_owned = true;
		init_pool(queue.pool);
	}

	mutex_init(&queue.mutex);
	condition_init(&queue.condition);

	queue.max_messages = max_messages;
}

/// Terminates the `queue`.
terminate :: fn (queue: *Queue) {
	loop msg := queue.head; msg; {
		next :: msg._next;
		put_allocator(queue.pool, msg.allocator);
		msg = auto next;
	}

	mutex_terminate(&queue.mutex);
	condition_terminate(&queue.condition);

	if queue.pool_owned {
		terminate_pool(queue.pool);
		delete(queue.pool);
	}
	zeroinit(queue);
}

/// Allocates a new message for the `queue`. Once created, the message  should be posted to the queue using `post`
/// function or terminated by `terminate_message` function, otherwise it leaks.
make_message :: fn (TMessage: type #comptime, queue: *Queue) *TMessage {
	allocator :: get_allocator(queue.pool);
	msg :: new(TMessage, false, allocator);
	msg.allocator    = allocator;
	msg.parent_queue = auto queue;
	msg.typeid       = typeid(TMessage);
	return msg;
}

/// Terminates the message.
terminate_message :: fn (message: *Message) #inline {
	assert(message);

	queue :: message.parent_queue;
	put_allocator(queue.pool, message.allocator);
	zeroinit(message);
}

/// Post a new `message` into the queue in which the `message` was created by `make_message` call. Post might fail when
/// the target queue is full, and returns an error. In case of failure, message ownership stays on caller side, and
/// the message might be reposted later or should be terminated by `terminate_message` call to prevent any leaks.
///
/// Once posted message cannot be reposted again (checked by assert).
///
/// Worker thread sleeping on `poll` wakes and process the message.
post :: fn (message: *Message) Error {
	assert(message);
	assert(!message.is_posted, "Attempt to repost already posted message.");

	queue :: message.parent_queue;
	assert(queue);

	mutex_lock(&queue.mutex);
	defer mutex_unlock(&queue.mutex);

	if queue.num >= queue.max_messages {
		return error("Maximum message count reached. Message ignored.");
	}

	slot := &queue.head;
	loop @slot {
		slot = &((@slot)._next);
	}
	@slot = message;
	queue.num += 1;

	message.is_posted = true;

	condition_signal(&queue.condition);
	return OK;
}

/// Polls a posted `message` from the `queue` into the `message` and returns `true`. Otherwise blocks in case `blocking`
/// is `true`. In non-blocking mode `false` is returned in case there is currently no message in the queue. Once message
/// is polled, it should be released by `terminate_message` call.
///
/// This version polls general `Message` type, you might distinguish messages by `message.typeid` before casting to
/// specific type; for example `if message.typeid == typeid(MyMessage) ...`. In case you only have one message type
/// [poll_as](modules_message_queue.html#poll_as) might be more convinient.
poll :: fn (queue: *Queue, message: **Message, blocking := false) bool {
	mutex_lock(&queue.mutex);
	defer mutex_unlock(&queue.mutex);

	if !blocking && !queue.head then return false;
	loop !queue.head {
		condition_wait(&queue.condition, &queue.mutex);
	}

	current :: queue.head;
	assert(current.is_posted);

	queue.head = queue.head._next;
	@message   = auto current;

	queue.num -= 1;
	return true;
}

/// Same as [poll](modules_message_queue.html#poll), but expecting concrete message type `TMessage`.
poll_as :: fn (queue: *Queue, message: **?TMessage, blocking := false) bool #inline {
	tmp: *Message;
	if !poll(queue, &tmp, blocking) {
		return false;
	}
	assert(tmp.typeid == typeid(TMessage));
	@message = auto tmp;
	return true;
}

/// Returns number of pending messages in the queue.
get_pending_message_count :: fn (queue: *Queue) s32 {
	mutex_lock(&queue.mutex);
	defer mutex_unlock(&queue.mutex);

	return queue.num;
}

/// Clears all pending messages in the `queue` and returns count of them.
clear :: fn (queue: *Queue) s32 {
	mutex_lock(&queue.mutex);
	defer mutex_unlock(&queue.mutex);

	loop msg := queue.head; msg; {
		next :: msg._next;
		put_allocator(queue.pool, msg.allocator);
		msg = auto next;
	}

	num :: queue.num;
	queue.num = 0;
	return num;
}

#scope_module

threading :: #import "std/thread2";

#import "std/type_utils";
#import "std/bucket_array"
#import "std/sync"
#import "std/array"
#import "std/pool"

get_allocator :: fn (pool: *MessagePool) *Allocator #inline {
	mutex_lock(&pool.mutex);
	defer mutex_unlock(&pool.mutex);

	allocator: *Allocator;
	if !array_pop(&pool.available, &allocator) {
		allocator = bucket_array_push(&pool.pools, pool_make(null, pool.expected_message_bytes));
	}
	assert(allocator);
	return allocator;
}

put_allocator :: fn (pool: *MessagePool, allocator: *Allocator)  #inline {
	assert(allocator);
	mutex_lock(&pool.mutex);
	defer mutex_unlock(&pool.mutex);

	reset_allocator(allocator);
	array_push(&pool.available, auto allocator);
}

