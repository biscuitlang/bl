#scope_private
#import "std/atomic"
#import "std/thread2"

run_in_parallel :: fn (ctx: *?T, worker: *fn (ctx: *?T) s32, NUM_THREADS := 8 #comptime) {
	if IS_COMPTIME_RUN {
		loop i := 0; i < NUM_THREADS; i += 1 {
			worker(ctx);
		}
		return;
	}

	threads: [NUM_THREADS]*Thread;
	loop i := 0; i < threads.len; i += 1 {
		threads[i] = spawn_with_context(ctx, worker);
	}

	join_all(threads);
	destroy_all(threads);
}

simple_counter_add :: fn () #test {
	counter: s32;
	run_in_parallel(&counter, &fn (c: *s32) s32 {
			loop i := 0; i < 100; i += 1 {
				fetch_add(c, 1);
			}
			return 0;
		});

	test_eq(counter, 800);
}

simple_counter_sub :: fn () #test {
	counter: s32;
	run_in_parallel(&counter, &fn (c: *s32) s32 {
			loop i := 0; i < 100; i += 1 {
				fetch_sub(c, 1);
			}
			return 0;
		});

	test_eq(counter, -800);
}

fetch_add_test :: fn (T: type #comptime) {
	n: T = 1;
	test_eq(fetch_add(&n, 1), 1);
	test_eq(n, 2);
}

simple_fetch_add :: fn () #test {
	fetch_add_test(u8);
	fetch_add_test(u16);
	fetch_add_test(u32);
	fetch_add_test(u64);
	fetch_add_test(s8);
	fetch_add_test(s16);
	fetch_add_test(s32);
	fetch_add_test(s64);
}

fetch_sub_test :: fn (T: type #comptime) {
	n: T = 1;
	test_eq(fetch_sub(&n, 1), 1);
	test_eq(n, 0);
}

simple_fetch_sub :: fn () #test {
	fetch_sub_test(u8);
	fetch_sub_test(u16);
	fetch_sub_test(u32);
	fetch_sub_test(u64);
	fetch_sub_test(s8);
	fetch_sub_test(s16);
	fetch_sub_test(s32);
	fetch_sub_test(s64);
}

fetch_or_test :: fn (T: type #comptime) {
	n: T = 0b1010;
	test_eq(fetch_or(&n, 0b101), 0b1010);
	test_eq(n, 0b1111);
}

