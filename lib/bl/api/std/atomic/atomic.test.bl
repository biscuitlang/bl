exchange_test :: fn (T: type #comptime) {
	n: T = 0b1010;
	test_eq(exchange(&n, 0b101), 0b1010);
	test_eq(n, 0b101);
}

simple_exchange :: fn () #test {
	exchange_test(u8);
	exchange_test(u16);
	exchange_test(u32);
	exchange_test(u64);
	exchange_test(s8);
	exchange_test(s16);
	exchange_test(s32);
	exchange_test(s64);
}

compare_exchange_test :: fn (T: type #comptime) {
	n: T = 10;
	e: T = 10;
	test_true(compare_exchange(&n, &e, 15));
	test_eq(n, 15);
	test_eq(e, 10);
	test_false(compare_exchange(&n, &e, 20));
	test_eq(n, 15);
}

simple_compare_exchange :: fn () #test {
	compare_exchange_test(u8);
	compare_exchange_test(u16);
	compare_exchange_test(u32);
	compare_exchange_test(u64);
	compare_exchange_test(s8);
	compare_exchange_test(s16);
	compare_exchange_test(s32);
	compare_exchange_test(s64);
}

