PTHREAD_MUTEX :: enum {
	TIMED_NP;
	RECURSIVE_NP;
	ERRORCHECK_NP;
	ADAPTIVE_NP;
	NORMAL     = TIMED_NP;
	RECURSIVE  = RECURSIVE_NP;
	ERRORCHECK = ERRORCHECK_NP;
	DEFAULT    = NORMAL;
}

__SIZEOF_PTHREAD_MUTEX_T :: 40;
__SIZEOF_PTHREAD_COND_T  :: 48;

pthread_mutex_t :: union {
	_: [__SIZEOF_PTHREAD_MUTEX_T]u8;
	__align: s32;
}

pthread_cond_t :: union {
	_: [__SIZEOF_PTHREAD_COND_T]u8;
	__align: s64;
}

pthread_condattr_t :: struct {
	_: [4]C.char;
}

pthread_mutexattr_t :: struct {
	_: [4]C.char;
}
