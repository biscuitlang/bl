thread :: #import "std/thread2";
#import "std/print"

main :: fn () s32 {
	print("Start thread!!!\n");
	defer print("Threads joined!!!\n");

	t1 :: thread.spawn(&first) catch panic($);
	t2 :: thread.spawn(&second) catch panic($);

	thread.join(t1) catch panic($);
	thread.join(t2) catch panic($);

	thread.destroy(t1);
	thread.destroy(t2);

	return 0;
}

first :: fn () s32 {
	loop i := 0; i < 10; i += 1 {
		print("Hello from first thread!\n");
		os_sleep_ms(50);
	}
	return 0;
}

second :: fn () s32 {
	loop i := 0; i < 10; i += 1 {
		print("Hello from second thread!\n");
		os_sleep_ms(100);
	}
	return 0;
}
