thread :: #import "std/thread2";
#import "std/print"

COUNT :: 50;
counter: s32 #thread_local;

main :: fn () s32 {
	print("Start thread!!!\n");
	defer print("Threads joined!!!\n");
	t1 :: thread.spawn(&first) catch panic($);
	t2 :: thread.spawn(&second) catch panic($);
	thread.join(t1) catch panic($);
	thread.join(t2) catch panic($);
	thread.destroy(t1);
	thread.destroy(t2);

	assert(counter == 0);
	return 0;
}

first :: fn () s32 {
	loop i := 0; i < COUNT; i += 1 {
		counter += 1;
		os_sleep_ms(5);
	}
	assert(counter == COUNT);
	return 0;
}

second :: fn () s32 {
	loop i := 0; i < COUNT; i += 1 {
		counter += 1;
		os_sleep_ms(10);
	}
	assert(counter == COUNT);
	return 0;
}
